<Window x:Class="Atty.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Atty.Wpf"
        mc:Ignorable="d"
        Title="PuTTY AI Terminal"
        Width="1540"
        Height="920"
        MinWidth="1360"
        MinHeight="860"
        Background="#D8DCE2"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="ClassicButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#E2E4E8" />
            <Setter Property="BorderBrush" Value="#A4AAB2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F1F1F" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ClassicButtonStyle}">
            <Setter Property="Background" Value="#6F8EBE" />
            <Setter Property="BorderBrush" Value="#5878A5" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="#F7F7F8" />
            <Setter Property="BorderBrush" Value="#B4B8BF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="#F7F7F8" />
            <Setter Property="BorderBrush" Value="#B4B8BF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Visibility="{Binding ShowConfigView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="24,18,0,14" FontSize="18" Foreground="#8F8F8F" Text="↳ AI CLI 환경 설정 및 터미널" />
            <Border Grid.Row="1" Margin="120,0,120,30" BorderBrush="#38527E" BorderThickness="1" CornerRadius="4" Background="#DFE1E5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="#203440">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Border Width="16" Height="16" CornerRadius="8" Background="#0D53FF" Margin="0,0,7,0">
                                    <TextBlock Text="S" Foreground="White" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="12" Text="PuTTY AI Configuration" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="_" FontSize="16" Foreground="White" Margin="0,0,14,0" />
                                <TextBlock Text="□" FontSize="14" Foreground="White" Margin="0,0,14,0" />
                                <TextBlock Text="×" FontSize="16" Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="144" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="12" Margin="0,0,0,4" Text="Category:" />
                            <Border BorderBrush="#BBBFC5" BorderThickness="1" Background="#F1F2F4">
                                <TreeView Background="Transparent" BorderThickness="0" SelectedItemChanged="OnCategorySelected" ItemsSource="{Binding Categories}">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type local:CategoryNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#222" />
                                        </HierarchicalDataTemplate>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                                            <Setter Property="Padding" Value="2" />
                                        </Style>
                                    </TreeView.Resources>
                                </TreeView>
                            </Border>
                        </StackPanel>
                        <Grid Grid.Column="2">
                            <Grid Visibility="{Binding IsSessionCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border BorderBrush="#C9CCD1" BorderThickness="1" Background="#DFE1E5" Padding="8">
                                    <StackPanel>
                                        <Border BorderBrush="#C4C7CC" BorderThickness="1" Background="#E7E8EA" Padding="4,4">
                                            <TextBlock Text="Basic options" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel Margin="0,10,0,0">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Text="Session Name:" />
                                                <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding SessionName}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="102" />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="Host (SSH):" />
                                                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding Host}" />
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="Port:" />
                                                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding Port}" />
                                                </Grid>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Text="Username:" />
                                                <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding Username}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Text="Password:" />
                                                <PasswordBox Grid.Column="1" Height="31" Padding="9,0" Background="#F7F7F8" BorderBrush="#B4B8BF" BorderThickness="1" FontSize="13" PasswordChanged="PasswordChanged" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0" Text="Mode:" />
                                                <RadioButton Content="SSH" IsChecked="{Binding IsSshMode}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                                <RadioButton Content="AI CLI" IsChecked="{Binding IsAiCliMode}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                                <RadioButton Content="Hybrid" IsChecked="{Binding IsHybridMode}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0" Text="Status:" />
                                                <Ellipse Width="16" Height="16" Fill="{Binding ConnectionStatusBrush}" Stroke="#4F9830" />
                                                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="14" Foreground="{Binding ConnectionStatusBrush}" Text="{Binding ConnectionStatusText}" />
                                            </StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Text="Provider:" />
                                                <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBoxStyle}" SelectedIndex="0">
                                                    <ComboBoxItem Content="Local AI Engine" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Text="Model:" />
                                                <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBoxStyle}" SelectedIndex="0">
                                                    <ComboBoxItem Content="coder-large" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Text="Workspace:" />
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="76" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding WorkspacePath}" />
                                                    <Button Grid.Column="2" Style="{StaticResource ClassicButtonStyle}" Content="Browse" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                        <Border Height="1" Background="#C8CBD1" Margin="0,12,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ClassicButtonStyle}" Content="Open SSH" Click="OpenDashboard" />
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Open AI Terminal" Click="OpenDashboard" />
                                            <Button Style="{StaticResource ClassicButtonStyle}" Content="Open Both" Click="OpenDashboard" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Visibility="{Binding IsNotSessionCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border BorderBrush="#C9CCD1" BorderThickness="1" Background="#DFE1E5" Padding="8">
                                    <StackPanel>
                                        <Border BorderBrush="#C4C7CC" BorderThickness="1" Background="#E7E8EA" Padding="4,4">
                                            <TextBlock Text="{Binding CategoryTitle}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding GenericCategoryLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#CFD3D8" BorderThickness="0,0,0,1" Padding="2,8">
                                                        <TextBlock FontSize="13" Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,8,8">
                        <Button Style="{StaticResource ClassicButtonStyle}" Content="About" />
                        <Button Style="{StaticResource ClassicButtonStyle}" Content="Save" />
                        <Button Style="{StaticResource ClassicButtonStyle}" Content="Help" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="#33415A">
                <Grid Margin="26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="#F3F5FB" FontSize="18" Margin="0,0,38,0" Text="Dashboard" />
                        <TextBlock Foreground="#F3F5FB" FontSize="18" Margin="0,0,38,0" Text="File Manager" />
                        <TextBlock Foreground="#F3F5FB" FontSize="18" Margin="0,0,38,0" Text="Logs" />
                        <TextBlock Foreground="#F3F5FB" FontSize="18" Margin="0,0,38,0" Text="Settings" />
                        <StackPanel>
                            <TextBlock Foreground="#F3F5FB" FontSize="18" Text="AI Assistant" />
                            <Border Height="5" Width="184" Background="#3F7CFF" CornerRadius="2" Margin="-10,18,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="#F3F5FB" FontSize="26" Margin="0,0,26,0" Text="🔔" />
                        <TextBlock Foreground="#F3F5FB" FontSize="26" Margin="0,0,26,0" Text="⚙" />
                        <TextBlock Foreground="#F3F5FB" FontSize="26" Text="⏻" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="26,30,26,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F0F1F5" BorderBrush="#C4C8D1" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="100" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="70" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="25" Foreground="#304260" FontWeight="SemiBold" Text="SSH Connection" />
                            <Border Grid.Column="1" Height="28" Padding="16,0" CornerRadius="6" Background="{Binding ConnectionStatusBrush}" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="15" Text="{Binding ConnectionStatusText}" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="26,18,26,14">
                            <TextBlock FontSize="21" Foreground="#304260" Text="{Binding ServerDisplay, StringFormat=Server: {0}}" />
                            <TextBlock FontSize="21" Foreground="#304260" Margin="0,8,0,0" Text="{Binding UserDisplay, StringFormat=User: {0}}" />
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="22,20,22,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="56" />
                            </Grid.RowDefinitions>
                            <Border Background="#232E3B" BorderBrush="#2C3440" BorderThickness="1" CornerRadius="4,4,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding TerminalLines}" Margin="20,22">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:TerminalLineViewModel}">
                                                <TextBlock FontFamily="Consolas" FontSize="20" Text="{Binding Text}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#F1F5F6" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCommand}" Value="True">
                                                                    <Setter Property="Foreground" Value="#7ADD96" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSecondary}" Value="True">
                                                                    <Setter Property="Foreground" Value="#EEF2F2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Row="1" Background="#232E3B" BorderBrush="#2C3440" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4">
                                <Grid Margin="20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Consolas" FontSize="18" Foreground="#7ADD96" Text="{Binding CurrentPromptText}" />
                                        <TextBox Width="280" Margin="10,0,0,0" Background="Transparent" BorderThickness="0" Foreground="White" FontFamily="Consolas" FontSize="18" Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="TerminalInputKeyDown" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Width="78" Height="32" VerticalAlignment="Center" Background="#3F7CFF" BorderBrush="#3C64A2" Foreground="White" FontWeight="SemiBold" Content="Send" Click="SendTerminalCommand" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Button Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0" Height="44" MinWidth="158" Padding="20,0" Background="#4F5D77" BorderBrush="#54637D" Foreground="White" FontSize="17" FontWeight="SemiBold" Content="Disconnect" Click="ShowConfig" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="#F0F1F5" BorderBrush="#C4C8D1" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="72" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="86" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="25" Foreground="#304260" FontWeight="SemiBold" Text="AI Assistant" />
                                <Ellipse Width="18" Height="18" Fill="#58A96F" Margin="14,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="26" Foreground="#9098A8" Margin="0,0,22,0" Text="💬" />
                                <TextBlock FontSize="26" Foreground="#9098A8" Margin="0,0,22,0" Text="⤢" />
                                <TextBlock FontSize="26" Foreground="#9098A8" Text="✕" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="#F4F5F8" BorderBrush="#DADDE4" BorderThickness="0,1,0,1">
                            <TextBlock VerticalAlignment="Center" Margin="38,0,0,0" FontSize="19" Foreground="#374761" Text="Welcome! How can I assist you today?" />
                        </Border>
                        <ScrollViewer Grid.Row="2" Background="#F8F8FB">
                            <StackPanel Margin="24,22,24,18">
                                <Border HorizontalAlignment="Right" MaxWidth="360" Margin="0,0,0,24" Padding="22,18" CornerRadius="18" Background="#657491">
                                    <TextBlock FontSize="20" Foreground="White" Text="Hello! How can I help you?" TextWrapping="Wrap" />
                                </Border>
                                <Border HorizontalAlignment="Left" MaxWidth="320" Margin="0,0,0,24" Padding="22,18" CornerRadius="18" Background="#E1E3E8">
                                    <TextBlock FontSize="20" Foreground="#34445C" Text="Show me the server status." TextWrapping="Wrap" />
                                </Border>
                                <Border HorizontalAlignment="Right" MaxWidth="480" Margin="0,0,0,24" Padding="22,18" CornerRadius="18" Background="#3F7CFF">
                                    <TextBlock FontSize="20" Foreground="White" Text="Sure! Fetching the server status for you..." TextWrapping="Wrap" />
                                </Border>
                                <Border Width="520" HorizontalAlignment="Left" Margin="0,0,0,24" Padding="22,18" CornerRadius="18" Background="#ECECF1">
                                    <StackPanel>
                                        <TextBlock FontSize="20" Foreground="#33435C" Text="Current Server Status: 🖥️" />
                                        <Border Height="1" Background="#CFD3DC" Margin="0,16,0,14" />
                                        <TextBlock FontSize="18" Foreground="#33435C" Margin="0,0,0,12" Text="• Uptime: 3 days, 4 hours, 23 minutes" />
                                        <TextBlock FontSize="18" Foreground="#33435C" Margin="0,0,0,12" Text="• Load Average: 0.12, 0.05, 0.01" />
                                        <TextBlock FontSize="18" Foreground="#33435C" Margin="0,0,0,12" Text="• Disk Usage: /home 12.5 GB used of 20 GB" />
                                        <TextBlock FontSize="18" Foreground="#33435C" Text="• Memory Usage: 1.2 GB used / 3.8 GB total" />
                                    </StackPanel>
                                </Border>
                                <Border HorizontalAlignment="Left" MaxWidth="460" Padding="22,18" CornerRadius="18" Background="#E1E3E8">
                                    <TextBlock FontSize="20" Foreground="#34445C" Text="Let me know if you need any further assistance!" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="3" Background="#F4F5F8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBox Margin="24,16,10,18" Style="{StaticResource FieldTextBoxStyle}" Text="Type a message..." />
                            <Button Grid.Column="1" Margin="0,16,24,18" Background="#3F7CFF" BorderBrush="#3C64A2" Foreground="White" FontSize="18" FontWeight="SemiBold" Content="Send" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
